# Получите бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Дополнительные настройки
GEMINI_TIMEOUT_SECONDS=180
GEMINI_MAX_RETRIES=5
REPORT_TIMEZONE=Asia/Almaty

# Версия агента берётся из Git (commit/tag). Эта переменная нужна,
# только если проект запускается из архива без папки .git.
# AGENT_VERSION=1.0.0
